{
  "name": "simonne-piriz-services",
  "compatibility_date": "2026-10-06",
  // worker.js only handles /api/*; every other request is a static page from the assets.
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "previews": {}
}
